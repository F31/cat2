{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catcube.dev/contracts/events/verify.OrgAdminChanged.v1.json",
  "title": "verify.OrgAdminChanged.v1",
  "description": "组织管理员变更（邀请/确认/移除/归属申请）。",
  "type": "object",
  "required": ["event_id", "topic", "occurred_at", "space_id", "payload"],
  "properties": {
    "event_id": { "type": "string" },
    "topic": { "const": "verify.OrgAdminChanged.v1" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "space_id": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["org_id", "user_id", "action"],
      "additionalProperties": false,
      "properties": {
        "org_id": { "type": "string" },
        "user_id": { "type": "string" },
        "action": { "type": "string", "enum": ["affiliation_applied", "invited", "confirmed", "removed"] }
      }
    }
  }
}
