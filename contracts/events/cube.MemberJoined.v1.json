{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catcube.dev/contracts/events/cube.MemberJoined.v1.json",
  "title": "cube.MemberJoined.v1",
  "description": "猫立方成员加入（邀请制）。供 notice/msg 群成员同步消费。",
  "type": "object",
  "required": ["event_id", "topic", "occurred_at", "space_id", "payload"],
  "properties": {
    "event_id": { "type": "string" },
    "topic": { "const": "cube.MemberJoined.v1" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "space_id": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["cube_id", "user_id"],
      "properties": {
        "cube_id": { "type": "string" },
        "user_id": { "type": "string" },
        "role": { "type": "integer" },
        "operator_id": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
