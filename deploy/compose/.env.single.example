# 单机首上线配置（复制为 .env.single，勿提交）
# 密码请使用 URL 安全字符（A-Z a-z 0-9），避免 @ : / # 等导致连接串解析失败
CATCUBE_ENV=production
POSTGRES_PASSWORD=change-me-db
REDIS_PASSWORD=change-me-redis
API_PORT=8080

# 32 字节 hex（64 位），可用：openssl rand -hex 32
IDENTITY_ENC_KEY=
BLIND_KEY=

# 微信小程序（生产）
WECHAT_APPID=
WECHAT_SECRET=

# 微信支付 V3（可选；未配置时生产环境自动禁用支付，接口明确失败，不会回退可伪造的开发态）
# 私钥/平台证书放入 deploy/compose/secrets/ 并挂载到 /run/secrets；路径相对容器。
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_FILE=/run/secrets/wechatpay_private_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_CERT_FILE=/run/secrets/wechatpay_platform_cert.pem
WECHAT_PAY_NOTIFY_URL=https://cat2.mindbase.fun/api/mp/v1/pay/notify

# 后台口令登录（生产主路径）：手机号 + hash-password 生成的哈希
ADMIN_PHONE=
ADMIN_PASSWORD_HASH=

# 对象存储/CDN（生产；当前为阿里云 OSS V1 签名，非阿里云需另接适配器）
OSS_ENDPOINT=
OSS_BUCKET=
OSS_AK=
OSS_SK=
CDN_HOST=

# 内容安全：生产填 wechat（文本机检；图片异步待接入）；留空=不机检
MODERATION=
# 生产必须留空（短信网关适配器待接入）
# CATCUBE_SMS_DEV_CODE 固定为空
# 实名认证：生产 true=身份证正反面 + 本地校验 + 运营审核；仅开发可 false
REALNAME_MANUAL_REVIEW=true

# 可观测（可选）
OTEL_ENABLED=false
OTEL_ENDPOINT=otel-collector:4317

# 运维
DRAIN_SECONDS=10
CONTACT_DAILY_LIMIT=200
BACKUP_RETAIN_DAYS=14
